      "scale": {
       "from": [
        0,
        100
       ],
       "to": [
        0,
        100
       ]
      },
      "round": "floor"
     }
    },
    {
     "input": "level",
     "target": "state:fill"
    },
    {
     "input": "label",
     "target": "label:label"
    },
    {
     "input": "display",
     "target": "label:display"
    }
   ]
