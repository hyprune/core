{
 "formatVersion": "0.10",
 "id": "mini-conveyor",
 "version": "1.0.0",
 "name": "Mini conveyor",
 "category": "machines",
 "scene": "mini-conveyor.gltf",
 "license": "CC0-1.0",
 "attribution": [
  {
   "path": ".",
   "author": "Hyprune contributors",
   "license": "CC0-1.0"
  }
 ],
 "bounds": {
  "min": [
   -2,
   0,
   -0.5
  ],
  "max": [
   2,
   2.05,
   0.5
  ]
 },
 "traits": {
  "decorative": {
   "animations": [
    {
     "node": "spinner",
     "type": "spin",
     "axis": [
      0,
      1,
      0
     ],
     "pivot": [
      0,
      1.5,
      0
     ],
     "period": 2
    },
    {
     "node": "lift",
     "type": "bob",
     "axis": [
      0,
      1,
      0
     ],
     "amplitude": 0.4,
     "period": 4
    }
   ]
  },
  "machine": {
   "primary": "status",
   "positions": [
    {
     "node": "lift",
     "range": [
      0.75,
      1.25
     ]
    }
   ],
   "inputs": [
    {
     "id": "status",
     "type": "enum",
     "values": [
      "idle",
      "running",
      "ok",
      "fail"
     ],
     "default": "idle",
     "label": "Status",
     "explain": "Lamps and spinner."
    },
    {
     "id": "stage",
     "type": "enum",
     "values": [
      "idle",
      "running",
      "ok",
      "fail"
     ],
     "default": "idle",
     "repeat": 2,
     "label": "Stage",
     "explain": "Per lamp."
    },
    {
     "id": "started",
     "type": "event",
     "label": "Started",
     "explain": "A token per start."
    },
    {
     "id": "queued",
     "type": "int",
     "min": 0,
     "max": 12,
     "default": 0,
     "label": "Queued",
     "explain": "Crates."
    },
    {
     "id": "progress",
     "type": "number",
     "min": 0,
     "max": 1,
     "default": 0,
     "label": "Progress",
     "explain": "Lift height."
    },
    {
     "id": "name",
     "type": "text",
     "maxLength": 12,
     "label": "Name",
     "explain": "Panel."
    }
   ],
   "drives": [
    {
     "input": "stage.{n}",
     "target": "state:lamp_{n}"
    },
    {
     "input": "status",
     "target": "animation:spinner",
     "map": {
      "cases": [
       {
        "equals": "running",
        "to": 1
       }
      ],
      "else": 0
     }
    },
    {
     "input": "status",
     "target": "visible:alarm",
     "map": {
      "cases": [
       {
        "equals": "fail",
        "to": true
       }
      ],
      "else": false
     }
    },
    {
     "input": "status",
     "target": "effect:cheer",
     "map": {
      "becomes": "ok",
      "from": "running"
     }
    },
    {
     "input": "status",
     "target": "emission:lamp_1",
     "map": {
      "cases": [
       {
        "equals": "fail",
        "to": 2
       }
      ],
      "else": 1
     }
    },
    {
     "input": "started",
     "target": "spawn:in"
    },
    {
     "input": "queued",
     "target": "count:waiting"
    },
    {
     "input": "progress",
     "target": "position:lift"
    },
    {
     "input": "name",
     "target": "label:sign"
    }
   ]
  }
 },
